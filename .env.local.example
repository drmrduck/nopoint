# Copy to .env.local and fill in the values you want.
#
# Anything starting with NEXT_PUBLIC_ is embedded in the client bundle at
# build time and is visible to anyone who views the page source. Keep
# server-only secrets under non-prefixed names.
#
# See README → "Environment variables" for the full table.


# ─── Canonical site URL ────────────────────────────────────────────────
#
# Public origin of THIS deployment. Used as `metadataBase` for canonical
# tags, sitemap.xml, robots.txt, JSON-LD, and the host string in OG
# images. Set this for any fork or self-hosted deployment — otherwise
# canonical tags point at the upstream nopoint.app demo, which Google
# treats as a duplicate and which Slack/Twitter use to render the wrong
# OG preview.
#
# No trailing slash. NEXT_PUBLIC_ so client code (share links) sees it
# too. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as a fallback
# when this is unset — fine for *.vercel.app preview URLs, but set this
# explicitly once you attach a custom domain.
NEXT_PUBLIC_SITE_URL=


# ─── Investor portal session ───────────────────────────────────────────
#
# HMAC secret used to sign the investor session cookie. REQUIRED in
# production — the app throws on boot in NODE_ENV=production if unset.
# In dev, a placeholder is used so you don't have to set this locally.
#
# Generate: openssl rand -hex 32
# Rotate: change the value (all existing sessions are invalidated).
INVESTOR_SESSION_SECRET=


# ─── Investor comment forwarding (optional) ────────────────────────────
#
# Incoming Slack webhook URL. When set, every comment submitted from the
# in-deck comment panel POSTs to Slack. When unset, comments are logged
# to the server console only — useful in dev. To add Discord / email /
# n8n / a custom endpoint, copy the prompt shown under the comment
# panel's "Local · Wire up notifications" block into Claude Code.
INVESTOR_COMMENTS_SLACK_WEBHOOK=


# ─── PostHog analytics (optional) ──────────────────────────────────────
#
# Project key (the phc_… value under Project Settings → Project API Key).
# Leave blank to disable PostHog entirely — the provider becomes a
# transparent pass-through and posthog-js is never initialised.
#
# Note: NEXT_PUBLIC_ ships this in the client bundle. Only paste a public
# *project* key here, never a personal API key.
NEXT_PUBLIC_POSTHOG_KEY=

# Ingest host. Defaults to https://us.i.posthog.com. Set to
# https://eu.i.posthog.com for EU cloud, or to your reverse-proxy host
# (e.g. https://ph.your-domain.com) to dodge ad-blockers. Only consulted
# when NEXT_PUBLIC_POSTHOG_KEY is set.
NEXT_PUBLIC_POSTHOG_HOST=


# ─── Chartcastr live sources (optional) ────────────────────────────────
#
# API key used by /api/chartcastr/[sourceId] to fetch live chart pulses.
# Required when any slide uses <ChartcastrSource>; the proxy returns 502
# if unset. Server-only — never rename to NEXT_PUBLIC_, the key would
# leak into the client bundle.
#
# Get / rotate keys at https://chartcastr.com/admin/settings/api-keys
CHARTCASTR_API_KEY=

# Optional override for the Chartcastr API base URL. Defaults to
# https://public.api.chartcastr.com/v1 — only set this if you're running
# Chartcastr itself locally (e.g. http://localhost:8109/v1). Trailing
# slash is stripped automatically.
CHARTCASTR_API_URL=


# ─── Favicon / manifest selector (optional) ────────────────────────────
#
# Set to "staging" to swap in the /staging-* favicon and manifest set so
# a staging tab is visually distinguishable from prod. Any other value
# (or unset) uses the prod set. NODE_ENV=development independently swaps
# in /dev-* — you don't need to set this in dev.
NEXT_PUBLIC_APP_ENV=
